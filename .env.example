# Environment Variables for Vajraa Intelligence

# Django Backend Configuration
DEBUG=False  # Set to False for production
SECRET_KEY=your-secret-key-here  # Set unique value in production
ALLOWED_HOSTS=vajraa-backend.onrender.com,localhost,127.0.0.1
CORS_ALLOW_ALL=False  # Set to False for production; use CORS_ALLOWED_ORIGINS instead

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3  # For development; use PostgreSQL in production

# Frontend Configuration
# For development (default): uses Vite proxy or direct API calls
# For production: set to your Render backend URL
VITE_API_URL=https://vajraa-backend.onrender.com/api

# Example production configuration:
# VITE_API_URL=https://vajraa-backend.onrender.com/api
# ALLOWED_HOSTS=vajraa-backend.onrender.com,127.0.0.1
# DEBUG=False
# CORS_ALLOW_ALL=False
